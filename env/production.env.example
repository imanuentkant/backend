# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# IMPORTANT: Trong production thực tế, KHÔNG hard-code values vào file này
# Sử dụng secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# File này chỉ là template để tham khảo
# ============================================

# Node Environment
NODE_ENV=production
SERVICE_NAME=backend

# API Configuration
API_HOST=0.0.0.0
API_PORT=3005
API_TITLE=Production API
API_DESCRIPTION=Production API Documentation
API_VERSION=1.0.0

# Authentication - SỬ DỤNG SECRETS MANAGER
API_ACCESS_TOKEN_SECRET={{SECRET_FROM_VAULT}}
API_ACCESS_TOKEN_TTL_IN_MINUTES=60
API_ACCESS_TOKEN_IGNORE_EXPIRATION=false
API_REFRESH_TOKEN_SECRET={{SECRET_FROM_VAULT}}
API_REFRESH_TOKEN_TTL_IN_DAYS=7
API_ACCESS_TOKEN_HEADER=x-api-token
API_LOGIN_USERNAME_FIELD=email
API_LOGIN_PASSWORD_FIELD=password

# Logging
API_LOG_ENABLE=true
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Database - SỬ DỤNG RDS/MANAGED DATABASE
DB_HOST={{RDS_ENDPOINT}}
DB_PORT=5432
DB_USERNAME={{SECRET_FROM_VAULT}}
DB_PASSWORD={{SECRET_FROM_VAULT}}
DB_NAME=production_db
DB_LOG_ENABLE=false
DB_SSL=true
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30000

# Redis - SỬ DỤNG ELASTICACHE/MANAGED REDIS
REDIS_URL={{REDIS_ENDPOINT}}
REDIS_PASSWORD={{SECRET_FROM_VAULT}}
REDIS_TLS=true

# MongoDB - CHO AUDIT LOGS
MONGO_URI={{MONGO_ENDPOINT}}
MONGO_DB=production_audit
MONGO_USERNAME={{SECRET_FROM_VAULT}}
MONGO_PASSWORD={{SECRET_FROM_VAULT}}

# File Storage - S3/MinIO
FILE_STORAGE_ENDPOINT={{S3_ENDPOINT}}
FILE_STORAGE_PORT=443
FILE_STORAGE_ACCESS_KEY={{SECRET_FROM_VAULT}}
FILE_STORAGE_SECRET_KEY={{SECRET_FROM_VAULT}}
FILE_STORAGE_USE_SSL=true
FILE_STORAGE_BASE_PATH=https://cdn.yourdomain.com
FILE_STORAGE_IMAGE_BUCKET=production-images
FILE_STORAGE_IMAGE_EXT=png
FILE_STORAGE_IMAGE_MIMETYPE=image/png

# Monitoring & Observability
SENTRY_DSN={{SECRET_FROM_VAULT}}
DATADOG_API_KEY={{SECRET_FROM_VAULT}}
NEW_RELIC_LICENSE_KEY={{SECRET_FROM_VAULT}}

# Feature Flags
FEATURE_FLAG_NEW_FEATURE=false

# External Services
SMTP_HOST={{SMTP_ENDPOINT}}
SMTP_PORT=587
SMTP_USER={{SECRET_FROM_VAULT}}
SMTP_PASSWORD={{SECRET_FROM_VAULT}}

# AWS Configuration (nếu deploy trên AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID={{SECRET_FROM_VAULT}}
AWS_SECRET_ACCESS_KEY={{SECRET_FROM_VAULT}}

# ============================================
# NOTES:
# 1. Tất cả {{SECRET_FROM_VAULT}} phải được thay thế bằng giá trị thực từ secrets manager
# 2. Không commit file này với giá trị thực vào git
# 3. Sử dụng environment-specific config trong Kubernetes/ECS/Docker
# 4. Rotate secrets định kỳ
# 5. Audit log access to secrets
# ============================================

