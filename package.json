{
  "name": "typescript-clean-architecture",
  "version": "1.0.0",
  "description": "It is my attempt to create Clean Architecture based application in Typescript",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "copy:local-env": "cp ./env/local.env ./dist/.env",
    "start": "node ./dist/Main.js",
    "start:local": "npm run copy:local-env && cd ./dist && node -r dotenv/config Main.js",
    "test": "jest --config jest.json",
    "test:cov": "jest --config jest.json --coverage",
    "lib:check": "ncu",
    "lib:upgrade": "ncu -u && npm install",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fix": "eslint --fix '{src,test}/**/*.ts'",
    "format": "prettier \"**/*.{ts,js,json,md,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{ts,js,json,md,yml,yaml}\" --check",
    "migration:create": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:create -n",
    "migration:revert": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:revert",
    "dev": "nest start --watch",
    "prepare": "husky install",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pvarentsov/typescript-clean-architecture.git"
  },
  "keywords": [
    "clean-architecture",
    "typescript"
  ],
  "author": "Pavel Varentsov (varentsovpavel@gmail.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "bugs": {
    "url": "https://github.com/pvarentsov/typescript-clean-architecture/issues"
  },
  "homepage": "https://github.com/pvarentsov/typescript-clean-architecture#readme",
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.1.4",
    "@types/bcryptjs": "3.0.0",
    "@types/busboy": "1.5.4",
    "@types/compression": "^1.7.5",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/minio": "7.1.1",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "6.0.3",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.37.0",
    "@typescript-eslint/parser": "8.37.0",
    "eslint": "9.31.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "globals": "^16.3.0",
    "husky": "9.1.6",
    "jest": "30.0.4",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "jsonwebtoken": "9.0.2",
    "lint-staged": "15.2.10",
    "npm-check-updates": "18.0.1",
    "prettier": "3.2.5",
    "supertest": "7.1.3",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@nestjs/common": "11.1.4",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.4",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.4",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "bcryptjs": "3.0.2",
    "bullmq": "^5.61.0",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "^1.8.1",
    "dotenv": "17.2.0",
    "env-var": "7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "minio": "8.0.5",
    "module-alias": "2.2.3",
    "mongodb": "^6.20.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.25",
    "typeorm-transactional": "^0.5.0",
    "uuid": "11.1.0"
  },
  "jest-junit": {
    "outputDirectory": ".coverage"
  },
  "jestSonar": {
    "sonar56x": true
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts}": [
      "eslint --fix"
    ]
  },
  "_moduleAliases": {
    "@core": "core",
    "@infrastructure": "infrastructure",
    "@application": "application"
  }
}
