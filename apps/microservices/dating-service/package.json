{
  "name": "@trungtamtrochoi/dating-service",
  "version": "1.0.0",
  "description": "Dating Service - Microservice for dating features",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
